---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
}

const { title = "10xCards" } = Astro.props;

// `missingConfigs` is a module-level constant (it reads `astro:env/server` at import time),
// so the session gate cannot live in it — it is a per-request fact and this layout is the
// per-request surface. Filter PER ENTRY, never the whole block: Supabase's warning carries
// `requiresSession: false` precisely because an unconfigured Supabase means nobody is ever
// signed in, so a block-level gate would hide the one banner that explains the breakage.
const visibleConfigs = missingConfigs.filter((cfg) => !cfg.requiresSession || Astro.locals.user);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    {
      visibleConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
