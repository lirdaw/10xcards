---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs, visibleConfigStatuses } from "@/lib/config-status";

interface Props {
  title?: string;
}

const { title = "10xCards" } = Astro.props;

// The session is a per-request fact and this layout is the per-request surface, so it is
// what supplies the flag; the decision itself lives in `visibleConfigStatuses`, where it has
// tests (tests/lib/config-status.test.ts).
const visibleConfigs = visibleConfigStatuses(missingConfigs, Boolean(Astro.locals.user));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    {
      visibleConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
