---
import AuthenticatedLayout from "@/layouts/AuthenticatedLayout.astro";
import { GeneratorForm } from "@/components/generate/GeneratorForm";
import { createClient } from "@/lib/supabase";
import { listDecks } from "@/lib/decks";
import { listActiveLanguages } from "@/lib/languages";

// Load the user's decks for the target selector, and the offered languages for the
// language selector. Branch on the query error vs empty (lessons: SSR error-vs-empty)
// so a transient DB failure renders an error state rather than silently offering only
// "Nowa talia" — or, for languages, a selector missing every language while looking
// like a deliberately short list. Route guard is in middleware — no top-level return
// in the frontmatter (lessons).
//
// The two reads are independent (the language dictionary is not scoped to the deck),
// so they go out together rather than one after the other.
//
// An EMPTY language list is NOT an error: it is the correct reading of an admin having
// deactivated everything, and the island still offers "Ten sam co tekst" (`auto`), which
// has no row behind it because it is a mode, not a language.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const [decksResult, languagesResult] = supabase
  ? await Promise.all([listDecks(supabase), listActiveLanguages(supabase)])
  : ([
      { data: null, error: null },
      { data: null, error: null },
    ] as const);
const loadError = decksResult.error ?? languagesResult.error;
const decks = (decksResult.data ?? []).map((d) => ({ publicId: d.public_id, name: d.name }));
const languages = (languagesResult.data ?? []).map((l) => ({ code: l.code, label: l.ui_label }));
---

<AuthenticatedLayout title="Generuj fiszki" activeItem="generate">
  <div class="mx-auto max-w-4xl">
    <h1
      class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold tracking-tight text-transparent"
    >
      Generuj fiszki
    </h1>
    <p class="mb-6 text-blue-100/70">
      Wklej tekst źródłowy, wybierz talię, język i liczbę kart — AI przygotuje kandydatów do przeglądu.
    </p>

    {
      loadError ? (
        <div class="rounded-2xl border border-red-500/30 bg-red-900/20 p-8 text-center text-red-200">
          <p>Nie udało się wczytać danych do generowania. Spróbuj odświeżyć stronę.</p>
        </div>
      ) : (
        <GeneratorForm decks={decks} languages={languages} client:load />
      )
    }
  </div>
</AuthenticatedLayout>
