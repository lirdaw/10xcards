---
import Layout from "@/layouts/Layout.astro";

// One copy, true under EITHER GoTrue configuration. This page used to branch on Vite's
// build-time `DEV` flag — the last read of that build-time env object anywhere in `src/`,
// against AGENTS.md's "read env only through `astro:env/server`", and now gated by
// tests/lib/no-env-access.test.ts. (That guard is a TEXTUAL scan, so spelling the forbidden
// token here — even inside a comment — turns it red. Deliberate trade, documented in its
// header: reword the prose, do not weaken the pattern.)
//
// The heuristic was wrong on its own terms too: `DEV` is a BUILD flag, resolved when the
// bundle is built, not "e-mail confirmations are off" — which is a per-project GoTrue
// setting (`supabase/config.toml` locally, the dashboard in the cloud). A production deploy
// with confirmations disabled therefore promised mail that is never sent. No server-side
// read answers that question either, so the copy stops asking it: the account exists in both
// configurations, and sign-in is the next step in both.
---

<Layout title="Account created">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <div class="mb-4 text-5xl">✅</div>
      <h1 class="mb-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Account created
      </h1>
      <p class="mb-6 text-blue-100/80">
        If a confirmation link arrives in your inbox, open it to activate your account. Otherwise you can sign in right
        away.
      </p>
      <a href="/auth/signin" class="text-sm text-purple-300 hover:underline">Go to sign in</a>
    </div>
  </div>
</Layout>
