# Copy to .env and fill in. Never commit real secrets — .env is gitignored.
#
# Local values: run `npm run db:start`, then `npx supabase status` and copy
# "Project URL" and the "Publishable" key from its output.
#
# SUPABASE_KEY must be the publishable (anon) key, never the secret/service_role key:
# a secret key bypasses RLS, and RLS is the only thing isolating accounts in this app.
# The test preflight (tests/setup/preflight.ts) refuses to run if you get this wrong.
SUPABASE_URL=
SUPABASE_KEY=

# Flashcard generation via OpenRouter. Unset locally = the generator falls back to mock
# mode; on production a missing key means mock cards ship silently, so set it there via
# `wrangler secret put OPENROUTER_API_KEY` and verify a real generation after deploy.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Sentry error monitoring. OPTIONAL locally and normally left EMPTY: an empty value is the
# SDK's no-transport branch, so local dev and the test suites stay silent. Set it here only
# while you deliberately want local events (see the runbook's local-proof step).
#
# On production it is NOT read from here — set it as a Worker secret with
# `wrangler secret put SENTRY_DSN`, pasting the value at the prompt rather than piping it
# (a piped value can pick up a BOM, which makes the DSN non-empty but broken: the SDK then
# initialises and silently sends nothing, and `wrangler secret list` cannot see the
# difference). A missing prod secret is silent by design, so verify by provoking a real
# event — context/changes/sentry-monitoring/deploy-runbook.md.
#
# Unlike the four above, this one is NOT in the astro:env schema: it is read in
# src/worker.ts off the Cloudflare `env`, which runs before Astro exists.
SENTRY_DSN=
